# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_new_bot_token_here
TELEGRAM_GROUP_ID=-1001234567890
PUBLIC_MINT_TOPIC_ID=12345
ADMIN_USER_IDS=123456789,987654321

# ─── OpenSea API ──────────────────────────────────────────────────────────────
OPENSEA_API_KEY=your_new_opensea_api_key_here
OPENSEA_API_ENDPOINT=https://api.opensea.io/api/v2

# ─── Chain configuration ───────────────────────────────────────────────────────
# Set to true to monitor all chains in ENABLED_CHAINS
MONITOR_ALL_CHAINS=true

# Comma-separated chain slugs to monitor.
# Available: base,ethereum,polygon,arbitrum,optimism,zora,robinhood,avalanche,
#            bsc,shape,abstract,apechain,arc,hyperevm,ink
# Note: bsc is not supported by OpenSea and will be skipped automatically.
ENABLED_CHAINS=base,ethereum,polygon,arbitrum,optimism,zora,robinhood,avalanche,bsc,shape,abstract,apechain,arc,hyperevm,ink

# ─── Polling ───────────────────────────────────────────────────────────────────
# How often to poll the API in seconds (e.g. 3600 for 1 hour, 45 for 45s)
POLL_INTERVAL_SECONDS=3600

# ─── Filtering ─────────────────────────────────────────────────────────────────
MIN_MINT_PRICE_USD=0
MAX_MINT_PRICE_USD=20

# For paid mints: offer must be >= mint_price × MIN_OFFER_MULTIPLIER
MIN_OFFER_MULTIPLIER=1.5

# For free mints ($0): offer must be >= FREE_MINT_MIN_OFFER_USD
FREE_MINT_MIN_OFFER_USD=5

# Minimum minted percentage (0-100)
MIN_MINTED_PERCENTAGE=70

# Whether to allow 100% sold-out mints
ALLOW_SOLD_OUT=false

# Whether to allow duplicate listings (same mint seen again)
DUPLICATE_LISTINGS=false

# Send notifications for all discovered mints immediately for manual filtering (true/false)
NOTIFY_ALL_DISCOVERED=true

# ─── Scheduling ────────────────────────────────────────────────────────────────
# Send notification this many minutes BEFORE mint start
NOTIFICATION_BEFORE_MINUTES=10

# Delete notification this many minutes AFTER mint start
DELETE_AFTER_MINUTES=15

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, recommended for single-server deployment)
DATABASE_URL=sqlite+aiosqlite:///./public_mint_bot.db

# PostgreSQL (for multi-server or high-availability deployment)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/publicmintbot

# ─── Operational ──────────────────────────────────────────────────────────────
# Set to true to use mock data and test Telegram without production alerts
TEST_MODE=false

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
